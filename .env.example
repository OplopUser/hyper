# =============================================================================
# Hyperliquid Trading Bot — Environment Variables Template
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# --- Hyperliquid Wallet ---
# Your wallet's private key (hex, with or without 0x prefix).
# Used to sign orders. Keep this secret.
PRIVATE_KEY=0xyour_private_key_here

# The address of your API wallet (the wallet tied to your private key).
# Found in your Hyperliquid account settings.
API_WALLET_ADDRESS=0xyour_api_wallet_address_here

# --- Network ---
# Set to "true" to trade on testnet (app.hyperliquid-testnet.xyz).
# Set to "false" for mainnet (app.hyperliquid.xyz).
USE_TESTNET=true

# --- AWS Credentials for Hydromancer Reservoir S3 (requester pays) ---
# These are your own AWS credentials — no Hyperliquid API key needed.
# The S3 bucket s3://hyperliquid-reservoir uses requester-pays billing,
# so your AWS account is charged for S3 request costs.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# --- Strategy Parameters (optional overrides — defaults set in config.py) ---
# Trading symbol (e.g., BTC, ETH, SOL)
SYMBOL=BTC

# Fast EMA period
EMA_FAST=9

# Slow EMA period
EMA_SLOW=21

# RSI period
RSI_PERIOD=14

# ATR period for stop-loss / take-profit calculation
ATR_PERIOD=14

# Max percentage of account equity per trade (0.02 = 2%)
MAX_RISK_PER_TRADE=0.02

# Maximum number of concurrent open positions
MAX_POSITIONS=3

# Bot loop interval in seconds
LOOP_INTERVAL=60
